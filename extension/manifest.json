{
  "manifest_version": 3,
  "name": "PokeSurvivor 한국어 모드",
  "version": "0.1.0",
  "description": "PokeSurvivor의 메뉴, 기술, 포켓몬 이름과 전투 표시를 한국어로 바꿉니다.",
  "minimum_chrome_version": "119",
  "permissions": ["storage"],
  "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"},
  "action": {
    "default_title": "PokeSurvivor 한국어 모드",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://pokesurvivor.pro/*", "https://www.pokesurvivor.pro/*"],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start",
      "world": "MAIN",
      "js": ["translations/moves.js", "translations/menus.js", "translations/progress.js", "translations/settings.js", "translations/extra.js", "translations/interface.js", "translations/changelog.js", "translations/pokemon.js", "translation-core.js", "canvas.js", "content.js"]
    },
    {
      "matches": ["https://pokesurvivor.pro/*", "https://www.pokesurvivor.pro/*"],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start",
      "world": "ISOLATED",
      "js": ["storage.js"],
      "css": ["korean.css"]
    }
  ]
}
