{
  "manifest_version": 3,
  "name": "PokéSurvivor 한국어 모드",
  "version": "0.2.24",
  "description": "PokéSurvivor의 메뉴, 기술, 포켓몬 이름과 전투 표시를 한국어로 바꿉니다.",
  "minimum_chrome_version": "119",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://pokesurvivor.com/*", "https://www.pokesurvivor.com/*", "https://pokesurvivor.net/*"],
  "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"},
  "web_accessible_resources": [{
    "resources": ["fonts/neodgm/neodgm.woff2"],
    "matches": ["https://pokesurvivor.com/*", "https://www.pokesurvivor.com/*"]
  }],
  "action": {
    "default_title": "PokéSurvivor 한국어 모드",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://pokesurvivor.com/*", "https://www.pokesurvivor.com/*"],
      "exclude_globs": ["*://*/game-auth*"],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start",
      "world": "MAIN",
      "js": ["temp-melee-target.js", "collection.js", "effects.js", "network.js", "move-tooltip-data.js", "move-tooltips.js", "hud.js", "translations/moves.js", "translations/menus.js", "translations/progress.js", "translations/settings.js", "translations/extra.js", "translations/gameplay.js", "translations/shop.js", "translations/pokedex.js", "translations/interface.js", "translations/changelog.js", "translations/pokemon.js", "translation-core.js", "native-locale.js", "canvas.js", "content.js"]
    },
    {
      "matches": ["https://pokesurvivor.com/*", "https://www.pokesurvivor.com/*"],
      "exclude_globs": ["*://*/game-auth*"],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start",
      "world": "ISOLATED",
      "js": ["storage.js"],
      "css": ["fonts.css", "korean.css"]
    }
  ]
}
